{
  "manifest_version": 3,
  "name": "Open Download Manager",
  "version": "0.2.8",
  "description": "Capture file downloads and selected media links with the installed Open Download Manager desktop app.",
  "permissions": [
    "nativeMessaging",
    "downloads",
    "contextMenus",
    "storage",
    "webRequest"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://filesamples.com/*",
        "https://www.filesamples.com/*"
      ],
      "js": [
        "compat.js",
        "filesamples.js"
      ],
      "run_at": "document_start",
      "exclude_matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.googlevideo.com/*"
      ]
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "compat.js",
        "video-button.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "exclude_matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.googlevideo.com/*"
      ]
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "compat.js",
        "download-links.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "exclude_matches": [
        "*://youtube.com/*",
        "*://*.youtube.com/*",
        "*://youtu.be/*",
        "*://*.youtube-nocookie.com/*",
        "*://*.googlevideo.com/*"
      ]
    }
  ],
  "key": "",
  "minimum_chrome_version": "120",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Open Download Manager",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  },
  "incognito": "not_allowed",
  "options_ui": {
    "page": "consent.html",
    "open_in_tab": true
  }
}
