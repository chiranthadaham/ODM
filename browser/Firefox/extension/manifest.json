{
  "manifest_version": 2,
  "name": "Open Download Manager",
  "version": "2.7.0",
  "description": "Capture file downloads and selected media links with the installed Open Download Manager desktop app.",
  "browser_specific_settings": {
    "gecko": {
      "id": "opendownloadmanager@local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "browsingActivity",
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "nativeMessaging",
    "downloads",
    "contextMenus",
    "storage",
    "webRequest",
    "webRequestBlocking",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "scripts": [
      "formats.js",
      "background.js"
    ]
  },
  "browser_action": {
    "default_title": "Open Download Manager",
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": [
        "https://filesamples.com/*",
        "https://www.filesamples.com/*"
      ],
      "js": [
        "filesamples.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "video-button.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "download-links.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "incognito": "not_allowed",
  "options_ui": {
    "page": "consent.html",
    "open_in_tab": true
  }
}
