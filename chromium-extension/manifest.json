{
  "manifest_version": 3,
  "name": "Open Download Manager",
  "version": "2.6.0",
  "description": "Send links and YouTube pages to Open Download Manager, with optional automatic file capture.",
  "permissions": [
    "nativeMessaging",
    "downloads",
    "contextMenus",
    "storage",
    "activeTab",
    "webRequest"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "icons": {
    "48": "icon.png",
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://filesamples.com/*",
        "https://www.filesamples.com/*"
      ],
      "js": [
        "compat.js",
        "filesamples.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "compat.js",
        "video-button.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "compat.js",
        "download-links.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "key": "",
  "minimum_chrome_version": "120",
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_title": "Open Download Manager",
    "default_popup": "popup.html",
    "default_icon": "icon.png"
  }
}